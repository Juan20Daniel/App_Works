{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [],
    "typeRoots": ["./types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "presentation/*":["src/presentation/*"],
      "infrestructure/*":["src/infrestructure/*"],
      "assets/*":["src/assets/*"],
      "regex/*":["src/shared/*"]
    },
  },
  "include": ["**/*.ts", "**/*.tsx", "react-native.config.js"],
  "exclude": ["**/node_modules", "**/Pods"]
}

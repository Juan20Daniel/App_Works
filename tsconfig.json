{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "typeRoots": [
      "./types",
       "./node_modules/@types"
    ],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "react-native.config.js"],
  "exclude": ["**/node_modules", "**/Pods"]
}